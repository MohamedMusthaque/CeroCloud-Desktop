{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        /* Paths (resolved relative to this file; baseUrl is deprecated) */
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@electron/*": [
                "./electron/*"
            ]
        }
    },
    "include": [
        "src",
        "electron"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}